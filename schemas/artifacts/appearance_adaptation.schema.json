{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/appearance_adaptation",
  "title": "Reference Performance Appearance Adaptation",
  "description": "Style adaptation assessment and human-approved target-character appearance candidates derived from a reference video.",
  "type": "object",
  "required": [
    "version",
    "project_id",
    "decision",
    "style_mismatch",
    "style_contract",
    "target_identity",
    "candidates",
    "approval"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "project_id": { "type": "string" },
    "decision": {
      "type": "string",
      "enum": ["NOT_NEEDED", "CANDIDATES_READY", "APPROVED", "REJECTED"]
    },
    "style_mismatch": {
      "type": "object",
      "required": ["detected", "severity", "summary", "dimensions"],
      "properties": {
        "detected": { "type": "boolean" },
        "severity": { "type": "string", "enum": ["none", "minor", "major"] },
        "summary": { "type": "string" },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["wardrobe", "hair", "makeup", "lighting", "palette", "setting", "camera", "overall_tone"]
          }
        }
      },
      "additionalProperties": false
    },
    "style_contract": {
      "type": "object",
      "required": ["adapt", "preserve_identity", "adapt_attributes", "exclude_attributes"],
      "properties": {
        "adapt": { "type": "boolean" },
        "preserve_identity": { "type": "array", "items": { "type": "string" } },
        "adapt_attributes": { "type": "array", "items": { "type": "string" } },
        "exclude_attributes": { "type": "array", "items": { "type": "string" } },
        "reference_style_description": { "type": "string" },
        "target_appearance_prompt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "target_identity": {
      "type": "object",
      "required": ["source_path_or_url", "identity_attributes"],
      "properties": {
        "source_path_or_url": { "type": "string" },
        "identity_attributes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "status", "image_path", "source_tool", "prompt", "adapted_attributes"],
        "properties": {
          "candidate_id": { "type": "string" },
          "status": { "type": "string", "enum": ["candidate", "approved", "rejected"] },
          "image_path": { "type": "string" },
          "image_url": { "type": "string" },
          "source_tool": { "type": "string", "const": "hairfree_image" },
          "model": { "type": "string" },
          "prompt": { "type": "string" },
          "adapted_attributes": { "type": "array", "items": { "type": "string" } },
          "review_notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "selected_candidate_id": { "type": ["string", "null"] },
    "approval": {
      "type": "object",
      "required": ["human_approved", "notes"],
      "properties": {
        "human_approved": { "type": "boolean" },
        "approved_at": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metadata": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "decision": { "const": "APPROVED" } } },
      "then": {
        "required": ["selected_candidate_id"],
        "properties": {
          "selected_candidate_id": { "type": "string" },
          "approval": { "properties": { "human_approved": { "const": true } } }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "NOT_NEEDED" } } },
      "then": {
        "properties": {
          "style_mismatch": { "properties": { "detected": { "const": false } } },
          "selected_candidate_id": { "type": ["string", "null"] }
        }
      }
    }
  ],
  "additionalProperties": false
}

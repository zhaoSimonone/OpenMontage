{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/audio_timeline",
  "title": "Narrative Short Audio Timeline",
  "type": "object",
  "required": ["version", "project_id", "duration_seconds", "tracks", "subtitle_source"],
  "properties": {
    "version": {"type": "string", "const": "1.0"},
    "project_id": {"type": "string"},
    "duration_seconds": {"type": "number", "minimum": 20, "maximum": 45},
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "start_seconds", "end_seconds", "text_or_description"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string", "enum": ["narration", "dialogue", "music", "ambience", "sfx"]},
          "start_seconds": {"type": "number", "minimum": 0},
          "end_seconds": {"type": "number", "minimum": 0},
          "text_or_description": {"type": "string"},
          "source_path": {"type": "string"},
          "provider": {"type": "string"},
          "volume": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "subtitle_source": {"type": "string", "enum": ["tts_timestamps", "approved_script", "asr_fallback"]},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
